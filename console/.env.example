# OIDC / Keycloak settings, injected by Vite at build time (browser-visible).
# The defaults shown here match the Keycloak compose stack in console/compose.yaml.
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=fastvm
VITE_KEYCLOAK_CLIENT_ID=fastvm-console
VITE_KEYCLOAK_SCOPE=openid profile email

# The API proxy runs server-side in Vite (dev/preview), not in the browser.
# Default target: https://127.0.0.1:8443 with /tmp/fastvm/certs/client.
# Override for another host/cert location:
#   export FASTVM_HOST=https://127.0.0.1:8443
#   export FASTVM_CERT_PATH=/tmp/fastvm/certs/client
#
# Explicit Unix socket fallback (opt-in):
#   export FASTVM_SOCKET=/run/fastvm/fastvm.sock
